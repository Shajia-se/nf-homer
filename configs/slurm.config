process {
  executor = 'slurm'
  queue    = 'cpu_p'

  clusterOptions = "--qos=cpu_normal --nice=10000 --mail-type=END,FAIL --mail-user=${params.mail_user}"

  container        = params.container_homer

  containerOptions = params.extra_mounts

  withName: 'homer_motif' {
    cpus   = params.motif_cpus
    memory = params.motif_memory
    time   = params.motif_time
  }

  withName: 'homer_motif_compare' {
    cpus   = params.motif_compare_cpus
    memory = params.motif_compare_memory
    time   = params.motif_compare_time
  }
}

singularity {
  enabled    = true
  autoMounts = true
}
